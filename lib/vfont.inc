; vfont.inc -- the vector font (generated by tools/genfont.py: edit
; the glyphs there). See lib/draw_text.asm.
;
; Strokes: vf_tab holds, for each character from vf_first, a word
; offset from vf_tab to its polylines: a count of points, then the
; points (x << 4 | y on the 4 x 6 grid, y down); a count of 0 ends
; the character. Characters without a glyph point to the space.
; HUD digits: vf_dig, the digits 0-9 then a blank (vf_blank), each
; vf_dh rows of one byte, bit 7 = the left pixel: the digits' strokes
; rasterized at 6 px by 7 rows.
;
; No "end" directive -- meant to be included.

vf_first    equ     32
vf_n        equ     59              ; ' ' .. 'Z'
vf_adv      equ     6               ; cell advance, grid units
vf_dh       equ     7               ; HUD digit rows
vf_blank    equ     10              ; the blank HUD digit

        even
vf_tab:
        dc.w    vf_g20-vf_tab           ; ' '
        dc.w    vf_g20-vf_tab           ; '!'
        dc.w    vf_g20-vf_tab           ; '"'
        dc.w    vf_g20-vf_tab           ; '#'
        dc.w    vf_g20-vf_tab           ; '$'
        dc.w    vf_g20-vf_tab           ; '%'
        dc.w    vf_g20-vf_tab           ; '&'
        dc.w    vf_g20-vf_tab           ; "'"
        dc.w    vf_g20-vf_tab           ; '('
        dc.w    vf_g20-vf_tab           ; ')'
        dc.w    vf_g20-vf_tab           ; '*'
        dc.w    vf_g20-vf_tab           ; '+'
        dc.w    vf_g20-vf_tab           ; ','
        dc.w    vf_g2d-vf_tab           ; '-'
        dc.w    vf_g2e-vf_tab           ; '.'
        dc.w    vf_g2f-vf_tab           ; '/'
        dc.w    vf_g30-vf_tab           ; '0'
        dc.w    vf_g31-vf_tab           ; '1'
        dc.w    vf_g32-vf_tab           ; '2'
        dc.w    vf_g33-vf_tab           ; '3'
        dc.w    vf_g34-vf_tab           ; '4'
        dc.w    vf_g35-vf_tab           ; '5'
        dc.w    vf_g36-vf_tab           ; '6'
        dc.w    vf_g37-vf_tab           ; '7'
        dc.w    vf_g38-vf_tab           ; '8'
        dc.w    vf_g39-vf_tab           ; '9'
        dc.w    vf_g3a-vf_tab           ; ':'
        dc.w    vf_g20-vf_tab           ; ';'
        dc.w    vf_g20-vf_tab           ; '<'
        dc.w    vf_g20-vf_tab           ; '='
        dc.w    vf_g20-vf_tab           ; '>'
        dc.w    vf_g20-vf_tab           ; '?'
        dc.w    vf_g20-vf_tab           ; '@'
        dc.w    vf_g41-vf_tab           ; 'A'
        dc.w    vf_g42-vf_tab           ; 'B'
        dc.w    vf_g43-vf_tab           ; 'C'
        dc.w    vf_g44-vf_tab           ; 'D'
        dc.w    vf_g45-vf_tab           ; 'E'
        dc.w    vf_g46-vf_tab           ; 'F'
        dc.w    vf_g47-vf_tab           ; 'G'
        dc.w    vf_g48-vf_tab           ; 'H'
        dc.w    vf_g49-vf_tab           ; 'I'
        dc.w    vf_g4a-vf_tab           ; 'J'
        dc.w    vf_g4b-vf_tab           ; 'K'
        dc.w    vf_g4c-vf_tab           ; 'L'
        dc.w    vf_g4d-vf_tab           ; 'M'
        dc.w    vf_g4e-vf_tab           ; 'N'
        dc.w    vf_g4f-vf_tab           ; 'O'
        dc.w    vf_g50-vf_tab           ; 'P'
        dc.w    vf_g51-vf_tab           ; 'Q'
        dc.w    vf_g52-vf_tab           ; 'R'
        dc.w    vf_g53-vf_tab           ; 'S'
        dc.w    vf_g54-vf_tab           ; 'T'
        dc.w    vf_g55-vf_tab           ; 'U'
        dc.w    vf_g56-vf_tab           ; 'V'
        dc.w    vf_g57-vf_tab           ; 'W'
        dc.w    vf_g58-vf_tab           ; 'X'
        dc.w    vf_g59-vf_tab           ; 'Y'
        dc.w    vf_g5a-vf_tab           ; 'Z'
vf_g20: dc.b    0                                           ; ' '
vf_g2d: dc.b    2,$13,$33,0                                 ; '-'
vf_g2e: dc.b    2,$25,$26,0                                 ; '.'
vf_g2f: dc.b    2,$40,$06,0                                 ; '/'
vf_g30: dc.b    5,$00,$40,$46,$06,$00,0                     ; '0'
vf_g31: dc.b    2,$20,$26,0                                 ; '1'
vf_g32: dc.b    6,$00,$40,$43,$03,$06,$46,0                 ; '2'
vf_g33: dc.b    4,$00,$40,$46,$06,2,$03,$43,0               ; '3'
vf_g34: dc.b    3,$00,$03,$43,2,$40,$46,0                   ; '4'
vf_g35: dc.b    6,$40,$00,$03,$43,$46,$06,0                 ; '5'
vf_g36: dc.b    6,$40,$00,$06,$46,$43,$03,0                 ; '6'
vf_g37: dc.b    3,$00,$40,$46,0                             ; '7'
vf_g38: dc.b    5,$00,$40,$46,$06,$00,2,$03,$43,0           ; '8'
vf_g39: dc.b    6,$43,$03,$00,$40,$46,$06,0                 ; '9'
vf_g3a: dc.b    2,$21,$22,2,$24,$25,0                       ; ':'
vf_g41: dc.b    5,$06,$02,$20,$42,$46,2,$04,$44,0           ; 'A'
vf_g42: dc.b    5,$00,$06,$46,$43,$03,3,$00,$30,$33,0       ; 'B'
vf_g43: dc.b    4,$40,$00,$06,$46,0                         ; 'C'
vf_g44: dc.b    7,$00,$20,$42,$44,$26,$06,$00,0             ; 'D'
vf_g45: dc.b    4,$40,$00,$06,$46,2,$03,$33,0               ; 'E'
vf_g46: dc.b    3,$40,$00,$06,2,$03,$33,0                   ; 'F'
vf_g47: dc.b    6,$40,$00,$06,$46,$43,$23,0                 ; 'G'
vf_g48: dc.b    2,$00,$06,2,$40,$46,2,$03,$43,0             ; 'H'
vf_g49: dc.b    2,$10,$30,2,$20,$26,2,$16,$36,0             ; 'I'
vf_g4a: dc.b    4,$40,$46,$06,$04,0                         ; 'J'
vf_g4b: dc.b    2,$00,$06,3,$40,$03,$46,0                   ; 'K'
vf_g4c: dc.b    3,$00,$06,$46,0                             ; 'L'
vf_g4d: dc.b    5,$06,$00,$22,$40,$46,0                     ; 'M'
vf_g4e: dc.b    4,$06,$00,$46,$40,0                         ; 'N'
vf_g4f: dc.b    5,$00,$40,$46,$06,$00,0                     ; 'O'
vf_g50: dc.b    5,$06,$00,$40,$43,$03,0                     ; 'P'
vf_g51: dc.b    5,$00,$40,$46,$06,$00,2,$35,$57,0           ; 'Q'
vf_g52: dc.b    5,$06,$00,$40,$43,$03,2,$13,$46,0           ; 'R'
vf_g53: dc.b    6,$40,$00,$03,$43,$46,$06,0                 ; 'S'
vf_g54: dc.b    2,$00,$40,2,$20,$26,0                       ; 'T'
vf_g55: dc.b    4,$00,$06,$46,$40,0                         ; 'U'
vf_g56: dc.b    3,$00,$26,$40,0                             ; 'V'
vf_g57: dc.b    5,$00,$06,$24,$46,$40,0                     ; 'W'
vf_g58: dc.b    2,$00,$46,2,$40,$06,0                       ; 'X'
vf_g59: dc.b    3,$00,$23,$40,2,$23,$26,0                   ; 'Y'
vf_g5a: dc.b    4,$00,$40,$06,$46,0                         ; 'Z'

        even
vf_dig:
        dc.b    $fc,$84,$84,$84,$84,$84,$fc     ; 0
        dc.b    $20,$20,$20,$20,$20,$20,$20     ; 1
        dc.b    $fc,$04,$04,$fc,$80,$80,$fc     ; 2
        dc.b    $fc,$04,$04,$fc,$04,$04,$fc     ; 3
        dc.b    $84,$84,$84,$fc,$04,$04,$04     ; 4
        dc.b    $fc,$80,$80,$fc,$04,$04,$fc     ; 5
        dc.b    $fc,$80,$80,$fc,$84,$84,$fc     ; 6
        dc.b    $fc,$04,$04,$04,$04,$04,$04     ; 7
        dc.b    $fc,$84,$84,$fc,$84,$84,$fc     ; 8
        dc.b    $fc,$84,$84,$fc,$04,$04,$fc     ; 9
        dc.b    0,0,0,0,0,0,0                   ; blank
        even
